# =============================================================================
# DataLink Pipeline — environment variables
# Copy this file to .env and fill in values. .env is gitignored.
# Any DL_-prefixed var overrides the corresponding path in YAML config
# (use __ as the nesting separator, e.g. DL_ADAPTERS__WAREHOUSE__PATH=./wh.duckdb).
# =============================================================================

# ----- Environment selection -------------------------------------------------
# local | dev | stage | prod
DL_ENV=local

# local_sequential | airflow_kind
#   local_sequential  — DAGs run as in-process Python (default; no K8s needed)
#   airflow_kind      — Airflow on local kind K8s (requires kind + helm + kubectl)
DL_ORCHESTRATOR=local_sequential

# ----- Feature toggles (plug-in / plug-out contract) -------------------------
DL_FEATURES__GX__ENABLED=true
DL_FEATURES__AGENTS__ENABLED=true

# ----- Warehouse router ------------------------------------------------------
# Comma-separated list of operational DB targets to push Gold into.
# Options: sqlserver, postgres
DL_FEATURES__WAREHOUSE_ROUTER__TARGETS=sqlserver,postgres

# ----- LLM provider ----------------------------------------------------------
# stub  — offline, canned responses (default for local)
# anthropic — real Claude API (requires ANTHROPIC_API_KEY)
DL_ADAPTERS__LLM__TYPE=stub
ANTHROPIC_API_KEY=
# Model selection when DL_ADAPTERS__LLM__TYPE=anthropic
DL_ADAPTERS__LLM__MODEL=claude-haiku-4-5-20251001

# ----- Local service credentials (docker-compose defaults) -------------------
# sFTP (atmoz/sftp container)
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USER=datalink
SFTP_PASSWORD=datalink_local_only

# Azurite (ADLS Gen2 emulator) — the single well-known dev account
AZURITE_ACCOUNT_NAME=devstoreaccount1
AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURITE_BLOB_ENDPOINT=http://localhost:10000/devstoreaccount1

# SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=DataLink_LocalOnly_2026!
SQLSERVER_DATABASE=datalink_um

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=datalink
POSTGRES_PASSWORD=datalink_local_only
POSTGRES_DATABASE=datalink_um

# Webhook stub (local Teams replacement — logs notifications to file)
WEBHOOK_STUB_URL=http://localhost:9000/notify

# ----- Prod-only (leave blank in local) --------------------------------------
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_ROLE=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_KEYVAULT_URL=

# ----- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
DL_LOG_LEVEL=INFO
# json | console
DL_LOG_FORMAT=console

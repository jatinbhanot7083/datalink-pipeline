# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
.venv-airflow/
venv/
env/

# --- uv ---
# uv.lock IS committed; cache is not
.uv-cache/

# --- dbt ---
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/profiles/*.local.yml
dbt/.user.yml

# --- DuckDB (local warehouse state) ---
*.duckdb
*.duckdb.wal
warehouse.duckdb*

# --- Great Expectations artifacts ---
# The full gx/ tree is auto-generated by `gx.get_context(mode="file")` on the
# first checkpoint run. Keeping it out of git means a fresh clone doesn't
# ship stale expectation suites — they rebuild deterministically from
# `datalink/quality/suites/*.py` every time a DAG fires.
gx/

# --- Airflow local state ---
airflow.db
airflow-webserver.pid
logs/
dags/__pycache__/

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
# Note: datalink/adapters/secrets/ contains the SecretProvider adapter code,
# not actual secrets. Don't glob-exclude "secrets/" — use specific file patterns above.

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker / volumes ---
.docker-data/
docker-compose.override.yml

# --- Test artifacts ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Build ---
build/
dist/
*.egg

# --- OS / misc ---
.test_write.txt

# --- Sample data that is too big to commit ---
data/sample/large/
# Phase 5.7 executive-demo dataset is regenerated on demand via
# `make demo-reset-exec` (100K claims across 3 date-stamped batches).
# Keep the small committed claims_sample.csv / membership_sample.csv /
# provider_sample.csv as the dev-loop baseline.
data/sample/claims_[0-9]*.csv

# Phase 5.7 demo evidence (Playwright screenshots from verify-phase-5.7)
demo_evidence/

# Enforce LF on all text we care about, regardless of host OS.
# Keeps Windows + WSL2 + CI consistent.
* text=auto eol=lf

*.py     text eol=lf
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.sql    text eol=lf
*.json   text eol=lf
Makefile text eol=lf

# Binary — never normalize
*.docx   binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.duckdb binary
